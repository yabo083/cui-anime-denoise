/* Window and file icon. The .ico is the upstream app's (MIT).
 * configure_file() stamps the project version into the version block. */
#include <windows.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/assets/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Anime Denoise"
            VALUE "FileDescription", "Anime Denoise"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "AnimeDenoise"
            VALUE "OriginalFilename", "AnimeDenoise.exe"
            VALUE "ProductName", "Anime Denoise"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
